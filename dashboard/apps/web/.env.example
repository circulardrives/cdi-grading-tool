# CDI API proxy target (used by Vite dev server)
VITE_CDI_API_PROXY_TARGET=http://127.0.0.1:8844
# Remote host example (h12-rome): VITE_CDI_API_PROXY_TARGET=http://192.168.0.54:8844
#
# Cross-subnet LAN: when your laptop and grading hosts are on different subnets but
# routing works, point the proxy at a reachable CDI API and set an explicit discover
# subnet for LAN scanning (auto-detect only sees local interfaces).
# Example:
#   VITE_CDI_API_PROXY_TARGET=http://192.168.0.54:8844
#   VITE_CDI_USE_MOCK_DATA=0
#   VITE_CDI_API_TOKEN=localdevtoken
#   VITE_CDI_DISCOVER_SUBNET=192.168.0.0/24

# Browser-facing API base (proxied in dev)
VITE_CDI_API_BASE_URL=/api/cdi

# Optional API token (must match CDI_HEALTH_API_TOKEN on backend)
VITE_CDI_API_TOKEN=

# Mock data mode (1 = use mock_data path on scan/report requests; 0 for live remote API)
VITE_CDI_USE_MOCK_DATA=1
# Remote host example: VITE_CDI_USE_MOCK_DATA=0
VITE_CDI_MOCK_DATA_PATH=src/cdi_health/mock_data

# Default subnet for LAN discovery on the Machines page (optional CIDR, e.g. 192.168.0.0/24)
VITE_CDI_DISCOVER_SUBNET=

# Dev server bind
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=3000
