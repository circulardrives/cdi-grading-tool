# Where the dashboard's proxy finds the CDI Health API.
VITE_CDI_API_PROXY_TARGET=http://127.0.0.1:8844

# The API's access token (the same value as in /etc/default/cdi-health-api).
# The proxy adds it to every request, so anyone who can open the dashboard can
# use the API. Leave unset when the API runs without a token.
# CDI_HEALTH_API_TOKEN=
