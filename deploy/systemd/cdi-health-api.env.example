# Required when binding the API beyond loopback (see lan.conf drop-in).
# Generate a strong random value, e.g.: openssl rand -hex 32
CDI_HEALTH_API_TOKEN=replace-with-strong-token

# Optional: extra directories (':'-separated) that scan/report requests may
# reference via mock_data / mock_file / config. The packaged mock data and
# config, the data dir (/var/lib/cdi-health), and /etc/cdi-health are always
# allowed. Paths must be readable under the unit's ProtectSystem=strict /
# ProtectHome=true sandbox (i.e. not under /home or /root).
# CDI_HEALTH_API_ALLOWED_DATA_PATHS=/srv/cdi-health/datasets
