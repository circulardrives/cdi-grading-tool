FROM oven/bun:1.3.12 AS builder

WORKDIR /app

COPY dashboard/package.json dashboard/bun.lock dashboard/turbo.json dashboard/tsconfig.json ./
COPY dashboard/.npmrc dashboard/.prettierrc dashboard/.prettierignore ./
COPY dashboard/apps ./apps
COPY dashboard/packages ./packages

ARG VITE_CDI_API_BASE_URL=/api/cdi
ARG VITE_CDI_USE_MOCK_DATA=0
ARG VITE_CDI_MOCK_DATA_PATH=/app/src/cdi_health/mock_data

ENV VITE_CDI_API_BASE_URL=${VITE_CDI_API_BASE_URL}
ENV VITE_CDI_USE_MOCK_DATA=${VITE_CDI_USE_MOCK_DATA}
ENV VITE_CDI_MOCK_DATA_PATH=${VITE_CDI_MOCK_DATA_PATH}

RUN bun install --frozen-lockfile
RUN bun run build

FROM nginx:1.27-alpine

# Official nginx image runs envsubst on /etc/nginx/templates/*.template at start.
# CDI_HEALTH_API_TOKEN is injected into proxy_set_header at runtime (not in the SPA).
ENV CDI_HEALTH_API_TOKEN=""
COPY deploy/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
