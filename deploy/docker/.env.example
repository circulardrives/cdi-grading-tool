# Copy to deploy/docker/.env or repo-root .env when using compose.

# Host port for the technician dashboard (nginx serves the built SPA).
DASHBOARD_PORT=3000

# Required shared API token. Nginx injects X-API-Token for /api/cdi; the SPA
# must NOT embed this value. The API refuses non-loopback binds without it.
CDI_HEALTH_API_TOKEN=replace-with-strong-token

# Name this machine shows as "This bench" in the dashboard (the API
# container's hostname). Defaults to "cdi-health"; set it to the host's name.
# CDI_BENCH_HOSTNAME=bench-01

# LAN discovery: default subnet to enter on the Discover page (UI only).
# CDI_DISCOVER_SUBNET=192.168.0.0/24

# Mock fixtures path (optional; used when "Use mock data" is enabled in the dashboard UI).
# VITE_CDI_MOCK_DATA_PATH=src/cdi_health/mock_data
