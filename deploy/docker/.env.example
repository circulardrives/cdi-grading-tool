# Copy to deploy/docker/.env or repo-root .env when using compose.

# Host port for the technician dashboard (nginx serves the built SPA).
DASHBOARD_PORT=3000

# Optional shared API token (must match on API + dashboard build args).
# CDI_HEALTH_API_TOKEN=replace-me

# Mock mode for the dashboard UI (1 = mock fixtures, 0 = live scans).
# VITE_CDI_USE_MOCK_DATA=1
