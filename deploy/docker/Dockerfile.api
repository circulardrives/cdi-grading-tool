FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        smartmontools \
        nvme-cli \
        sg3-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

ARG VERSION=0.9.4
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${VERSION}
RUN pip install --no-cache-dir ".[api]"

ENV CDI_HEALTH_DATA_DIR=/var/lib/cdi-health
RUN mkdir -p /var/lib/cdi-health

EXPOSE 8844

CMD ["python", "-m", "cdi_health.api.server", "--host", "0.0.0.0", "--port", "8844", "--data-dir", "/var/lib/cdi-health", "--allow-non-root", "--mock-data", "/app/src/cdi_health/mock_data"]
